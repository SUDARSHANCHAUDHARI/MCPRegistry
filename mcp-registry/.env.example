# Supabase — get these from your project settings at supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App URL — http://localhost:3000 for local, your domain for production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random secret for protecting /api/sync-github-stars and /api/health-check
# Generate one: openssl rand -base64 32
SYNC_SECRET=replace-with-a-random-secret

# Optional: higher GitHub API rate limit for star sync (50/hr → 5000/hr)
# GITHUB_TOKEN=ghp_your_token_here

# Optional: email notifications via Resend
# RESEND_API_KEY=re_your_key_here
